{
  "name": "winston-transport-mongoose",
  "version": "1.0.0",
  "description": "A custom Winston transport for Mongoose with TTL and batching support.",
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    }
  },
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsup src/index.ts --format cjs,esm --dts --clean",
    "dev": "tsup src/index.ts --format cjs,esm --watch --dts",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "eslint src/**/*.ts",
    "format": "prettier --write src/**/*.ts",
    "prepublishOnly": "npm run build && npm run test"
  },
  "keywords": [
    "winston",
    "mongoose",
    "mongodb",
    "transport",
    "logging",
    "ttl",
    "batching"
  ],
  "author": "Om Prakash Tiwari <optiwari.india@gmail.com>",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/optiwariindia/winston-transport-mongoose.git"
  },
  "bugs": {
    "url": "https://github.com/optiwariindia/winston-transport-mongoose/issues"
  },
  "homepage": "https://github.com/optiwariindia/winston-transport-mongoose#readme",
  "dependencies": {
    "mongoose": "^9.6.1",
    "winston": "^3.19.0",
    "winston-transport": "^4.9.0"
  },
  "devDependencies": {
    "@types/node": "^25.6.0",
    "eslint": "^10.3.0",
    "mongodb-memory-server": "^11.1.0",
    "prettier": "^3.8.3",
    "tsup": "^8.5.1",
    "typescript": "^6.0.3",
    "vitest": "^4.1.5"
  }
}
